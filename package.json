{
  "name": "sealgate-extension-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode content",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "lint:extension": "web-ext lint --source-dir dist --warnings-as-errors",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run format:check && npm run lint && npm run check && npm run test && npm run build",
    "package": "npm run build && npm run lint:extension && web-ext build --source-dir dist --artifacts-dir artifacts --overwrite-dest",
    "browser:install": "npm run browser:install:chrome",
    "browser:install:chrome": "browsers install chrome@stable --path .chrome-for-testing",
    "browser:install:firefox": "browsers install firefox@devedition --path .firefox-for-testing"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mozilla/firefox-devtools-mcp": "0.10.2",
    "@puppeteer/browsers": "3.2.2",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@testing-library/svelte": "5.4.2",
    "@types/chrome": "0.2.9",
    "@types/node": "26.5.0",
    "@vitest/expect": "5.0.0",
    "chrome-devtools-mcp": "1.9.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "web-ext": "10.6.0"
  }
}
