{
  "manifest_version": 3,
  "name": "Sealgate Tool Tracker",
  "description": "Tracks MCP and app tool calls in ChatGPT and Claude, and reports them to Sealgate or an OpenTelemetry endpoint.",
  "version": "0.1.2",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["alarms", "identity", "storage", "webRequest"],
  "host_permissions": ["https://chatgpt.com/*", "https://claude.ai/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "scripts": ["assets/background.js"],
    "service_worker": "assets/background.js",
    "type": "module",
    "preferred_environment": ["service_worker", "document"]
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://claude.ai/*"],
      "js": ["assets/page.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://chatgpt.com/*", "https://claude.ai/*"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Open Sealgate Tool Tracker"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tool-tracker@sealgate.ai",
      "data_collection_permissions": {
        "required": ["websiteActivity", "websiteContent"]
      }
    }
  }
}
